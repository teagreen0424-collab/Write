# ===== 数据库 =====
# SQLite 文件路径，相对 backend 目录
DATABASE_URL=sqlite:///./data/lingmo.db

# ===== LLM（OpenAI 兼容协议）=====
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 备用提供方（可选，业务层按 provider 切换）
ANTHROPIC_API_KEY=
ARK_API_KEY=
GEMINI_API_KEY=

# ===== 嵌入 =====
# local = 本地 bge-small-zh-v1.5；openai = 云端 OpenAI 兼容嵌入
EMBEDDING_SERVICE=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_MODEL_PATH=

# ===== 服务 =====
LOG_LEVEL=INFO
